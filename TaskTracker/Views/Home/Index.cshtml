@{
    ViewData["Title"] = "Welcome";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-lg-7 text-center">
        <i class="bi bi-check2-square display-1 text-primary"></i>
        <h1 class="display-5 fw-bold mt-3">Task Tracker</h1>
        <p class="lead text-muted">
            Organise your work, track progress, assign tasks to teammates,
            and never miss a deadline again.
        </p>
        <div class="mt-4 d-flex gap-3 justify-content-center">
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-4">
                <i class="bi bi-person-plus me-2"></i>Get Started
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg px-4">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </a>
        </div>
    </div>
</div>

<div class="row g-4 mt-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body">
                <i class="bi bi-kanban display-5 text-primary mb-3 d-block"></i>
                <h5 class="card-title">Manage Tasks</h5>
                <p class="card-text text-muted">Create, edit, and delete tasks with titles, descriptions, priorities, and due dates.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body">
                <i class="bi bi-people display-5 text-success mb-3 d-block"></i>
                <h5 class="card-title">Assign &amp; Collaborate</h5>
                <p class="card-text text-muted">Assign tasks to team members and leave comments to keep everyone in the loop.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm text-center p-3">
            <div class="card-body">
                <i class="bi bi-funnel display-5 text-warning mb-3 d-block"></i>
                <h5 class="card-title">Filter &amp; Focus</h5>
                <p class="card-text text-muted">Filter tasks by status (To Do / In Progress / Done) and priority to stay focused.</p>
            </div>
        </div>
    </div>
</div>
