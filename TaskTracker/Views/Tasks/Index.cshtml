@model IEnumerable<TaskItem>
@{
    ViewData["Title"] = "Tasks";
    int? statusFilter   = ViewBag.StatusFilter;
    int? priorityFilter = ViewBag.PriorityFilter;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0"><i class="bi bi-list-task me-2 text-primary"></i>Tasks</h1>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>New Task
    </a>
</div>

<!-- Filter bar -->
<div class="card mb-4 shadow-sm">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-sm-5 col-md-4">
                <label class="form-label fw-semibold mb-1">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All statuses</option>
                    @foreach (var s in Enum.GetValues<AppTaskStatus>())
                    {
                        var val = (int)s;
                        if (val == statusFilter)
                        {
                            <option value="@val" selected="selected">@DisplayName(s)</option>
                        }
                        else
                        {
                            <option value="@val">@DisplayName(s)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-sm-5 col-md-4">
                <label class="form-label fw-semibold mb-1">Priority</label>
                <select name="priority" class="form-select form-select-sm">
                    <option value="">All priorities</option>
                    @foreach (var p in Enum.GetValues<AppTaskPriority>())
                    {
                        var val = (int)p;
                        if (val == priorityFilter)
                        {
                            <option value="@val" selected="selected">@DisplayName(p)</option>
                        }
                        else
                        {
                            <option value="@val">@DisplayName(p)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-sm-2 col-md-2">
                <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
            @if (statusFilter.HasValue || priorityFilter.HasValue)
            {
                <div class="col-sm-auto col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="bi bi-x-circle me-1"></i>Clear
                    </a>
                </div>
            }
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox display-4"></i>
        <p class="mt-3 mb-0 fs-5">No tasks found.</p>
        <p class="small">@(statusFilter.HasValue || priorityFilter.HasValue ? "Try clearing your filters." : "Create your first task to get started.")</p>
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Due Date</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td>
                            <a asp-action="Details" asp-route-id="@task.Id"
                               class="text-decoration-none fw-semibold link-dark">
                                @task.Title
                            </a>
                        </td>
                        <td>
                            <span class="badge @StatusBadge(task.Status)">@DisplayName(task.Status)</span>
                        </td>
                        <td>
                            <span class="badge @PriorityBadge(task.Priority)">@DisplayName(task.Priority)</span>
                        </td>
                        <td>
                            @if (task.DueDate.HasValue)
                            {
                                bool overdue = task.DueDate < DateTime.Today && task.Status != AppTaskStatus.Done;
                                <span class="@(overdue ? "text-danger fw-semibold" : "")">
                                    @task.DueDate.Value.ToString("MMM d, yyyy")
                                    @if (overdue) { <i class="bi bi-exclamation-triangle-fill ms-1"></i> }
                                </span>
                            }
                            else { <span class="text-muted">—</span> }
                        </td>
                        <td>
                            @if (task.AssignedToUsername is not null)
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-person me-1"></i>@task.AssignedToUsername
                                </span>
                            }
                            else { <span class="text-muted">Unassigned</span> }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@task.Id"
                               class="btn btn-sm btn-outline-secondary" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@task.Id"
                               class="btn btn-sm btn-outline-primary ms-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@task.Id"
                               class="btn btn-sm btn-outline-danger ms-1" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mt-2">
        Showing <strong>@Model.Count()</strong> task(s)
    </p>
}

@functions {
    static string DisplayName(Enum value)
    {
        var field = value.GetType().GetField(value.ToString());
        var attr  = field?.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
                         .FirstOrDefault() as System.ComponentModel.DataAnnotations.DisplayAttribute;
        return attr?.Name ?? value.ToString();
    }

    static string StatusBadge(AppTaskStatus s) => s switch
    {
        AppTaskStatus.Todo       => "bg-secondary",
        AppTaskStatus.InProgress => "bg-warning text-dark",
        AppTaskStatus.Done       => "bg-success",
        _                        => "bg-secondary"
    };

    static string PriorityBadge(AppTaskPriority p) => p switch
    {
        AppTaskPriority.Low    => "bg-info text-dark",
        AppTaskPriority.Medium => "bg-warning text-dark",
        AppTaskPriority.High   => "bg-danger",
        _                      => "bg-secondary"
    };
}
